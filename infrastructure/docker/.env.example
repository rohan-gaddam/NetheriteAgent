# NetheriteAgent production environment template — CONFIGURATION ONLY.
#
#   cp .env.example .env    # then set real values
#
# SECRETS DO NOT LIVE IN THIS FILE. All passwords (PostgreSQL admin, least-
# privileged app role, Redis, and the owner BCrypt hash) are file-based docker
# compose secrets provisioned on the host under infrastructure/docker/secrets/
# (git-ignored) and mounted into the containers at /run/secrets/... . Provision
# them with:
#
#   $env:OWNER_PASSWORD = '<owner-login-password>'; .\scripts\generate-secrets.ps1
#
# That writes ./secrets/db_password (netherite_admin), ./secrets/db_app_password
# (netherite_app — the runtime DB user), ./secrets/redis_password,
# ./secrets/opa_policy_token, ./secrets/owner_password_hash and
# ./secrets/gemini_api_key (empty by default). Never place a secret in .env:
# values here pass through Compose variable interpolation, and a BCrypt hash's
# '$' characters would be re-interpreted and corrupted. File content is taken
# verbatim.
#
# gemini_api_key is a special case: docker-compose always declares it (its source
# file must exist for `docker compose up`), but the app only reads it when
# LLM_PROVIDER=gemini below. The default (unset / none) needs no real Gemini key.
#
# Password input (both generators): the password is read from the OWNER_PASSWORD
# environment variable or the interactive SecureString/TTY prompt. There is NO
# password command-line argument - a CLI password would be process-list visible,
# so it is deliberately not accepted. Neither generator ever prints the value.
#
# The values below are non-secret configuration.

# --- Database (identity + config) -------------------------------------------
# DB_USER drives the *postgres bootstrap* admin (netherite_admin) and the migrate
# service. The runtime app service runs as the least-privileged netherite_app
# (DB_SECRET_NAME=db_app_password) and must never use these admin credentials.
DB_NAME=netherite
DB_USER=netherite_admin

# --- Owner bootstrap account (email is config; hash lives in secrets/) ------
OWNER_EMAIL=owner@example.com
OWNER_ORG_NAME=NetheriteAgent
OWNER_ORG_SLUG=netherite

# --- Runtime ----------------------------------------------------------------
NETHERITE_ENV=production
OPA_TIMEOUT_MS=1000
SHUTDOWN_TIMEOUT_SECONDS=30
LOG_LEVEL_STATE=INFO

# --- LLM (optional; disabled by default) -------------------------------------
# LLM_PROVIDER=none runs without any provider key (semantic requests fail
# closed). To enable Google Gemini, set LLM_PROVIDER=gemini and a GEMINI_MODEL,
# and place the real key in ./secrets/gemini_api_key (a file secret — never a
# value in this file). To enable OpenRouter instead, set LLM_PROVIDER=openrouter
# and place the real key in ./secrets/openrouter_api_key. If the selected
# provider's key file is empty, the app entrypoint refuses to start.
#LLM_PROVIDER=none
#GEMINI_MODEL=
#OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# --- OIDC (leave disabled unless an IdP is configured) ----------------------
OIDC_ENABLED=false
OIDC_CALLBACK_BASE_URL=
OIDC_EXTERNAL_BASE_URL=

# --- Edge / TLS -------------------------------------------------------------
SESSION_COOKIE_SECURE=true
SITE_ADDRESS=localhost
BACKEND_UPSTREAM=app:8080
HTTP_PORT=80
HTTPS_PORT=443