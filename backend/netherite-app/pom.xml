<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.netherite</groupId>
        <artifactId>netherite-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>netherite-app</artifactId>
    <name>NetheriteAgent :: Application Bootstrap</name>
    <description>Spring Boot Modular Monolith Application Bootstrap</description>

    <dependencies>
        <!-- Internal Netherite Modules -->
        <dependency>
            <groupId>io.netherite</groupId>
            <artifactId>netherite-common</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netherite</groupId>
            <artifactId>netherite-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netherite</groupId>
            <artifactId>netherite-ingestion</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netherite</groupId>
            <artifactId>netherite-context</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netherite</groupId>
            <artifactId>netherite-policy-opa</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netherite</groupId>
            <artifactId>netherite-routing</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netherite</groupId>
            <artifactId>netherite-connectors</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netherite</groupId>
            <artifactId>netherite-state</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netherite</groupId>
            <artifactId>netherite-approval</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netherite</groupId>
            <artifactId>netherite-audit</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netherite</groupId>
            <artifactId>netherite-llm</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netherite</groupId>
            <artifactId>netherite-admin-api</artifactId>
        </dependency>

        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- WS8: Prometheus scrape registry for /actuator/prometheus (version from the
             Spring Boot dependency BOM). The actuator starter exposes the endpoint only
             when this registry is on the classpath. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Database Drivers & Migrations -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- OpenAPI / Swagger Documentation -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- Email Notifications -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- OIDC / JWT Validation -->
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>10.1</version>
        </dependency>

        <!-- HTTP Client for OIDC discovery + token exchange -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
        </dependency>

        <!-- Distributed Locking (Redisson RLock) -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Testing Dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>io.netherite.NetheriteApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
