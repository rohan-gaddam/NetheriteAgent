*.sw?
.DS_Store
Thumbs.db

# Logs & Temporary Files
logs/
*.log
scratch/
temp/
*.tmp
# Local environment files (any level; examples like .env.example stay tracked)
.env
**/.env
.env.*.local
**/.env.*
# Safe setup templates must stay tracked — never ignore them:
!**/.env.example
!**/secrets.example/
*.dump
*.bak

# Local classpath dump (absolute machine paths; regenerated by the build)
backend/maven-cp.txt
**/maven-cp.txt

# Production secrets (docker compose file secrets — never commit the real values)
# Safe template dir secrets.example/ stays tracked.
**/secrets/
infrastructure/docker/secrets/
!**/secrets.example/

# WS9 operational artifacts (PostgreSQL logical backups + manifests + lists)
infrastructure/docker/backups/
**/backups/

# verify-secret-handling scratch projects (both historical spellings)
infrastructure/docker/_p3tmp/
infrastructure/docker/.p3tmp/
**/_p3tmp/
**/.p3tmp/
*.p3tmp*
# Runtime OPA policy data (local materialization; never commit)
infrastructure/docker/opa/policies-data/
**/policies-data/
# Runtime OPA admin-token data (authz_tokens.json): compose now writes it to a
# container-local tmpfs; retained here as defense-in-depth so a stray copy on the
# host is never committed.

# Local Agent Key
agent_key.txt
NETHERITEAGENT_CAPABILITY_AND_SECURITY_ASSESSMENT.md
